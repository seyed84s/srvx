<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/srvx_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- App Bar / Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/srvx_surface"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextColor="@color/srvx_text_primary" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorColor="@color/srvx_gold"
                app:trackColor="@android:color/transparent" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top Hero Dashboard Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <!-- Account / Data Stats Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/srvx_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        app:cardBackgroundColor="@color/srvx_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/srvx_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layoutDirection="rtl"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">

                            <!-- Data Remaining -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/srvx_chip_protocol"
                                    android:padding="6dp"
                                    android:src="@drawable/srvx_ic_data"
                                    app:tint="@color/srvx_gold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="حجم باقی‌مانده"
                                        android:textColor="@color/srvx_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/srvx_data_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="—"
                                        android:textColor="@color/srvx_gold"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Vertical Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@color/srvx_card_stroke" />

                            <!-- Time Remaining -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/srvx_chip_protocol"
                                    android:padding="6dp"
                                    android:src="@drawable/srvx_ic_clock"
                                    app:tint="@color/srvx_emerald" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="زمان باقی‌مانده"
                                        android:textColor="@color/srvx_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/srvx_time_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="—"
                                        android:textColor="@color/srvx_emerald"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Refresh Icon -->
                            <ImageView
                                android:id="@+id/srvx_btn_refresh_status"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="بروزرسانی وضعیت"
                                android:padding="4dp"
                                android:src="@drawable/srvx_ic_refresh"
                                app:tint="@color/srvx_text_muted" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Hero Connection Dashboard Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/srvx_hero_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/srvx_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/srvx_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp">

                            <!-- Big Centerpiece Connect Button -->
                            <FrameLayout
                                android:id="@+id/srvx_hero_connect_btn"
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:background="@drawable/srvx_connect_btn_inactive"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/srvx_hero_power_icon"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="دکمه اتصال"
                                    android:src="@drawable/srvx_ic_power"
                                    app:tint="@color/srvx_text_primary" />
                            </FrameLayout>

                            <!-- Connection Status Text -->
                            <TextView
                                android:id="@+id/tv_test_state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/connection_not_connected"
                                android:textColor="@color/srvx_text_primary"
                                android:textSize="15sp" />

                            <!-- Latency / Real-Ping badge & Click to test action -->
                            <LinearLayout
                                android:id="@+id/layout_test"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/srvx_pill_ping_neutral"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/srvx_ic_signal"
                                    app:tint="@color/srvx_text_secondary" />

                                <TextView
                                    android:id="@+id/tv_ping_quick_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="تست پینگ اتصال"
                                    android:textColor="@color/srvx_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section Title / Server List Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="سرورهای امن SRVX"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_ping_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:text="⚡ تست سرعت سرورها"
                            android:textColor="@color/srvx_gold"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Subscription Tabs (if multiple groups) -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="@color/srvx_gold"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="scrollable"
                    app:tabSelectedTextColor="@color/srvx_gold"
                    app:tabTextAppearance="@style/TabLayoutTextStyle"
                    app:tabTextColor="@color/srvx_text_secondary" />

                <!-- Server List ViewPager2 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- Hidden FAB for backward compatibility -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:src="@drawable/ic_play_24dp"
                android:visibility="gone"
                app:tint="@color/colorWhite" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/srvx_surface"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/srvx_text_secondary"
        app:itemTextColor="@color/srvx_text_primary"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
