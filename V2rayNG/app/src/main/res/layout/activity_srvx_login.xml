<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/srvx_bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- Logo badge -->
            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/srvx_logo_badge"
                android:gravity="center"
                android:text="S"
                android:textColor="#0E1020"
                android:textSize="40sp"
                android:textStyle="bold"
                android:elevation="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SRVX"
                android:textColor="#E3C072"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.35"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اتصال امن، ساده و سریع"
                android:textColor="#9AA0C8"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp" />

            <!-- Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/srvx_card_bg"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ورود به حساب"
                    android:textColor="#E8E9F5"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نام کاربری"
                    android:textColor="#9AA0C8"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/srvx_username"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/srvx_field_bg"
                    android:textColor="#E8E9F5"
                    android:textColorHint="#6E75A0"
                    android:hint="نام کاربری خود را وارد کنید"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رمز عبور"
                    android:textColor="#9AA0C8"
                    android:textSize="12sp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/srvx_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/srvx_field_bg"
                    android:textColor="#E8E9F5"
                    android:textColorHint="#6E75A0"
                    android:hint="رمز عبور خود را وارد کنید"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/srvx_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E0607A"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp">

                    <Button
                        android:id="@+id/srvx_login_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/srvx_btn_bg"
                        android:text="ورود"
                        android:textColor="#0E1020"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:stateListAnimator="@null" />

                    <ProgressBar
                        android:id="@+id/srvx_progress"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#0E1020"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SRVX Secure Network"
                android:textColor="#4A507E"
                android:textSize="11sp"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
