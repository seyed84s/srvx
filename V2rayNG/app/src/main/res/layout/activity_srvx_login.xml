<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/srvx_bg_gradient"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.8" />

        <!-- Signature mark -->
        <ImageView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:src="@drawable/srvx_medallion"
            android:contentDescription="SRVX" />

        <!-- Wordmark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SRVX"
            android:textColor="#EBCE8A"
            android:textSize="30sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.62"
            android:paddingStart="10dp"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شبکه خصوصی"
            android:textColor="#8A91BE"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <!-- hairline rule with centre diamond -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="26dp">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#242A50" />
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:rotation="45"
                android:background="#C9A24B" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#242A50" />
        </LinearLayout>

        <!-- Grouped input panel: one tidy block, hairline between rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/srvx_input_group">

            <EditText
                android:id="@+id/srvx_username"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@null"
                android:hint="نام کاربری"
                android:textColor="#ECEDF7"
                android:textColorHint="#6E75A0"
                android:textSize="15sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:maxLines="1"
                android:gravity="center_vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="#242A50" />

            <EditText
                android:id="@+id/srvx_password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@null"
                android:hint="رمز عبور"
                android:textColor="#ECEDF7"
                android:textColorHint="#6E75A0"
                android:textSize="15sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- reserved error line: layout never jumps -->
        <TextView
            android:id="@+id/srvx_error"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:text=""
            android:textColor="#E0607A"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <!-- Action -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/srvx_login_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/srvx_button"
                android:backgroundTint="@null"
                android:text="ورود"
                android:textColor="#0A0D1E"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <ProgressBar
                android:id="@+id/srvx_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="#0A0D1E"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SRVX"
            android:textColor="#3A4070"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:layout_marginTop="28dp" />

    </LinearLayout>
</ScrollView>
